# Form submissions via Google Apps Script (see scripts/google-apps-script/).
# Set to the Web app URL ending in /exec. Empty → mailto fallback.
VITE_FORMS_ENDPOINT=

# Canonical site origin (no trailing slash).
VITE_SITE_ORIGIN=https://hackfarm.co.nz

# Firebase Auth + Realtime Database (inline home content editing).
# Public web config from Console → Project settings → Your apps.
# Not true secrets — they ship in the browser. Security is Auth + RTDB rules.
# See docs/FIREBASE-CMS.md for full setup.
# Leave unset to run on bundled defaults only (no remote load / no login).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# Soft kill-switch: set to 1/true to disable Auth + RTDB (bundled defaults only).
# Useful for production rollback without reverting code. Leave unset for normal CMS.
# VITE_CMS_DISABLED=

# Local RTDB seed only (never commit; not needed in GitHub Actions).
# FIREBASE_SEED_EMAIL=baerbelhack@gmail.com
# FIREBASE_SEED_PASSWORD=

# NIWA tides — server/CI only (never expose in VITE_*).
# GitHub Actions: add repository secret NIWA_API_KEY
# Local refresh: NIWA_API_KEY=... npm run tides
# NIWA_API_KEY=
