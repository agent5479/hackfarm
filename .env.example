# Form submissions — defaults to FormSubmit → baerbelhack@gmail.com if unset
# (Stay@hackfarm.co.nz often never receives FormSubmit's one-time activation email)
VITE_FORM_ENDPOINT=https://formsubmit.co/baerbelhack@gmail.com

# Canonical site origin (no trailing slash).
VITE_SITE_ORIGIN=https://hackfarm.co.nz

# NIWA tides — server/CI only (never expose in VITE_*).
# GitHub Actions: add repository secret NIWA_API_KEY
# Local refresh: NIWA_API_KEY=... npm run tides
# NIWA_API_KEY=
